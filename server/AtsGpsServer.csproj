<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AtsGpsServer</RootNamespace>
    <Version>1.4.2</Version>
    <AssemblyVersion>1.4.2.0</AssemblyVersion>
    <FileVersion>1.4.2.0</FileVersion>
    <Product>SGNIA - ATS Telemetry &amp; GPS Server</Product>
    <Authors>Gamaliel Velazquez Galicia (SGNIA)</Authors>
    <Company>SGNIA</Company>
    <Copyright>Copyright (c) 2026 Gamaliel Velazquez Galicia (SGNIA)</Copyright>
    <Description>Servidor de telemetria en tiempo real (30 Hz), extraccion cartografica binaria y puente WebSocket/HTTP para American Truck Simulator.</Description>
    <RepositoryUrl>https://github.com/Gamavg06/GpsATS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AtsGpsServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="TruckLib" Version="0.5.2" />
    <PackageReference Include="TruckLib.HashFs" Version="0.2.7" />
    <PackageReference Include="TruckLib.Models" Version="0.4.3" />
  </ItemGroup>

</Project>
