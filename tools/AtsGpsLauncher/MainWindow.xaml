<Window x:Class="AtsGpsLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGNIA • ATS Telemetría GPS Server v1.3.0"
        Height="620" Width="880"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#0A0E1A"
        Foreground="#E2E8F0">
    <Window.Resources>
        <!-- Estilos de Botones Modernos -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#059669"/>
            <Setter Property="BorderBrush" Value="#34D399"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#047857"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header con Logo/Banner -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards de Estado -->
            <RowDefinition Height="Auto"/> <!-- Barra de Botones de Control -->
            <RowDefinition Height="*"/>    <!-- Consola de Logs en Vivo -->
            <RowDefinition Height="Auto"/> <!-- Barra Inferior de Estado -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER CON LOGO Y BANNER -->
        <Border Grid.Row="0" Background="#111827" CornerRadius="12" BorderBrush="#1F2937" BorderThickness="1" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo SGNIA -->
                <Image Grid.Column="0" Source="Assets/Logosgnia.png" Height="50" Width="50" Margin="0,0,14,0" VerticalAlignment="Center"/>

                <!-- Título y Subtítulo -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SGNIA" FontWeight="Black" FontSize="20" Foreground="#38BDF8" Margin="0,0,8,0"/>
                        <TextBlock Text="TELEMETRÍA GPS SERVER" FontWeight="Bold" FontSize="18" Foreground="#F8FAFC" Margin="0,0,10,0"/>
                        <Border Background="#1E3A5F" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="v1.3.0" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Servidor nativo de telemetría SCS SDK • Enrutamiento A* vial • Sincronización USB y Wi-Fi" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Banner Derecho Decorativo -->
                <Image Grid.Column="2" Source="Assets/Bannersgnia.png" Height="42" MaxWidth="190" VerticalAlignment="Center" Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- 2. CARDS DE ESTADO (KPIs) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Servidor Web / API -->
            <Border Grid.Column="0" Background="#111827" CornerRadius="10" BorderBrush="#1F2937" BorderThickness="1" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="📡" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="SERVIDOR HTTP / WS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse x:Name="ServerStatusLed" Width="10" Height="10" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServerStatusText" Text="ACTIVO • PUERTO 35500" FontWeight="Black" FontSize="13" Foreground="#22C55E"/>
                    </StackPanel>
                    <TextBlock x:Name="ServerIpText" Text="IP: 127.0.0.1 (USB) / Detectando LAN..." FontSize="11" Foreground="#CBD5E1"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="PIN de Acceso: " FontSize="11" Foreground="#94A3B8"/>
                        <TextBlock x:Name="PinText" Text="----" FontWeight="Black" FontSize="12" Foreground="#F59E0B" Margin="0,0,8,0"/>
                        <Button Content="Copiar" Click="BtnCopyPin_Click" Style="{StaticResource ActionButton}" Padding="6,1" FontSize="10" Height="22"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Cable USB & ADB -->
            <Border Grid.Column="1" Background="#111827" CornerRadius="10" BorderBrush="#1F2937" BorderThickness="1" Padding="12" Margin="4,0,4,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="🔌" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="CABLE USB • ADB REVERSE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse x:Name="UsbStatusLed" Width="10" Height="10" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UsbStatusText" Text="CONECTADO • REVERSE ACTIVO" FontWeight="Black" FontSize="12" Foreground="#22C55E"/>
                    </StackPanel>
                    <TextBlock x:Name="UsbDeviceText" Text="Dispositivo: Xiaomi / stone" FontSize="11" Foreground="#CBD5E1"/>
                    <TextBlock Text="Enlace: tcp:35500 ➔ 127.0.0.1" FontSize="10" Foreground="#38BDF8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: ATS Telemetría SDK -->
            <Border Grid.Column="2" Background="#111827" CornerRadius="10" BorderBrush="#1F2937" BorderThickness="1" Padding="12" Margin="8,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="🚛" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="AMERICAN TRUCK SIMULATOR" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse x:Name="AtsStatusLed" Width="10" Height="10" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AtsStatusText" Text="SDK SCS CONECTADO" FontWeight="Black" FontSize="13" Foreground="#38BDF8"/>
                    </StackPanel>
                    <TextBlock x:Name="AtsSpeedText" Text="Telemetría en tiempo real: Listo" FontSize="11" Foreground="#CBD5E1"/>
                    <TextBlock Text="Shared Memory: SCS/Telemetry" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. BARRA DE BOTONES DE ACCIÓN RÁPIDA -->
        <Border Grid.Row="2" Background="#0F172A" CornerRadius="10" Padding="10" Margin="0,0,0,14">
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="⚡ Re-enlazar USB (ADB Reverse)" Click="BtnReverseUsb_Click" Style="{StaticResource PrimaryButton}" Margin="4"/>
                <Button Content="📲 Instalar APK en Celular" Click="BtnInstallApk_Click" Style="{StaticResource SuccessButton}" Margin="4"/>
                <Button Content="🔄 Reiniciar Servidor" Click="BtnRestartServer_Click" Style="{StaticResource ActionButton}" Margin="4"/>
                <Button Content="📂 Abrir Carpeta APKs" Click="BtnOpenApksFolder_Click" Style="{StaticResource ActionButton}" Margin="4"/>
                <Button Content="🧹 Limpiar Logs" Click="BtnClearLogs_Click" Style="{StaticResource ActionButton}" Margin="4"/>
            </WrapPanel>
        </Border>

        <!-- 4. CONSOLA DE LOGS EN VIVO -->
        <Border Grid.Row="3" Background="#030712" CornerRadius="10" BorderBrush="#1F2937" BorderThickness="1" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="REGISTRO DE ACTIVIDAD DEL SERVIDOR (LOGS)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtConsoleLog"
                             Background="Transparent"
                             Foreground="#38BDF8"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="11"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 5. BARRA DE PIE DE PÁGINA -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="SGNIA Interactive • ATS Telemetry &amp; GPS System" FontSize="10" Foreground="#475569" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtFooterStatus" Text="Listo para jugar. Conecta el teléfono por USB o Wi-Fi y abre la app." FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
