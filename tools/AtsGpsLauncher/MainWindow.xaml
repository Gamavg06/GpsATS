<Window x:Class="AtsGpsLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SGNIA • ATS Telemetria GPS Server v1.4.2"
        Icon="Assets/app.ico"
        Height="630" Width="890"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#0C1013"
        Foreground="#F1F5F9">
    <Window.Resources>
        <!-- Estilos de Botones Modernos Dark HUD -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#151C21"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#24303B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E2830"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#10171D"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón Primario Cyan -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#0F2432"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#163449"/>
                    <Setter Property="BorderBrush" Value="#7DD3FC"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0B1A24"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón Destacado Neón Verde -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#C7F36B"/>
            <Setter Property="BorderBrush" Value="#C7F36B"/>
            <Setter Property="Foreground" Value="#0C1013"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D6FA8A"/>
                    <Setter Property="BorderBrush" Value="#D6FA8A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B4E353"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Boton Mini para Copiar PIN -->
        <Style x:Key="MiniCopyButton" TargetType="Button">
            <Setter Property="Background" Value="#1A232A"/>
            <Setter Property="Foreground" Value="#C7F36B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D3D25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#283A1E"/>
                    <Setter Property="BorderBrush" Value="#C7F36B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Boton Mini Cyan para Descargar Platform-Tools (ADB) -->
        <Style x:Key="MiniLinkButton" TargetType="Button">
            <Setter Property="Background" Value="#0F2432"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#254860"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#163449"/>
                    <Setter Property="BorderBrush" Value="#7DD3FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header con Logo/Banner -->
            <RowDefinition Height="Auto"/> <!-- KPI Cards de Estado -->
            <RowDefinition Height="Auto"/> <!-- Barra de Botones de Control -->
            <RowDefinition Height="*"/>    <!-- Consola de Logs en Vivo -->
            <RowDefinition Height="Auto"/> <!-- Barra Inferior de Estado -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER CON LOGO Y BANNER -->
        <Border Grid.Row="0" Background="#151C21" CornerRadius="12" BorderBrush="#1E2830" BorderThickness="1" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo SGNIA -->
                <Image Grid.Column="0" Source="Assets/Logosgnia.png" Height="48" Width="48" Margin="0,0,14,0" VerticalAlignment="Center"/>

                <!-- Título y Subtítulo -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SGNIA" FontWeight="Black" FontSize="20" Foreground="#38BDF8" Margin="0,0,8,0"/>
                        <TextBlock Text="TELEMETRÍA GPS SERVER" FontWeight="Bold" FontSize="18" Foreground="#F1F5F9" Margin="0,0,10,0"/>
                        <Border Background="#162A38" BorderBrush="#254860" BorderThickness="1" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="v1.4.2" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Servidor nativo de telemetría SCS SDK • Enrutamiento A* vial • Sincronización USB y Wi-Fi" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Banner Derecho Decorativo -->
                <Image Grid.Column="2" Source="Assets/Bannersgnia.png" Height="40" MaxWidth="190" VerticalAlignment="Center" Opacity="0.95"/>
            </Grid>
        </Border>

        <!-- 2. CARDS DE ESTADO (KPIs) DARK HUD -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Servidor Web / API -->
            <Border Grid.Column="0" Background="#151C21" CornerRadius="10" BorderBrush="#1E2830" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="SERVIDOR HTTP / WS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse x:Name="ServerStatusLed" Width="10" Height="10" Fill="#C7F36B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServerStatusText" Text="ACTIVO • PUERTO 35500" FontWeight="Black" FontSize="13" Foreground="#C7F36B"/>
                    </StackPanel>
                    <TextBlock x:Name="ServerIpText" Text="IP: 127.0.0.1 (USB) / Detectando LAN..." FontSize="11" Foreground="#CBD5E1"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PIN de Acceso: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Border Background="#1C2618" BorderBrush="#384C1C" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                            <TextBlock x:Name="PinText" Text="----" FontWeight="Black" FontSize="12" Foreground="#C7F36B"/>
                        </Border>
                        <Button Content="Copiar" Click="BtnCopyPin_Click" Style="{StaticResource MiniCopyButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Cable USB & ADB -->
            <Border Grid.Column="1" Background="#151C21" CornerRadius="10" BorderBrush="#1E2830" BorderThickness="1" Padding="14" Margin="4,0,4,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="CABLE USB - ADB REVERSE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse x:Name="UsbStatusLed" Width="10" Height="10" Fill="#C7F36B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="UsbStatusText" Text="CONECTADO • REVERSE ACTIVO" FontWeight="Black" FontSize="12" Foreground="#C7F36B" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="UsbDeviceText" Text="Dispositivo: Celular enlazado" FontSize="11" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="UsbLinkText" Text="Enlace: tcp:35500 -> 127.0.0.1" FontSize="11" Foreground="#38BDF8" Margin="0,5,0,0"/>
                    <Button x:Name="BtnDownloadPlatformTools"
                            Content="Descargar Platform-Tools (ADB)"
                            Click="BtnDownloadPlatformTools_Click"
                            Visibility="Collapsed"
                            Style="{StaticResource MiniLinkButton}"
                            HorizontalAlignment="Left"
                            Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: ATS Telemetría SDK -->
            <Border Grid.Column="2" Background="#151C21" CornerRadius="10" BorderBrush="#1E2830" BorderThickness="1" Padding="14" Margin="8,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="AMERICAN TRUCK SIMULATOR" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse x:Name="AtsStatusLed" Width="10" Height="10" Fill="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AtsStatusText" Text="VERIFICANDO SDK SCS..." FontWeight="Black" FontSize="13" Foreground="#38BDF8"/>
                    </StackPanel>
                    <TextBlock x:Name="AtsSpeedText" Text="Telemetría en tiempo real: Listo" FontSize="11" Foreground="#CBD5E1"/>
                    <TextBlock Text="Shared Memory: SCS/Telemetry" FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. BARRA DE BOTONES DE ACCIÓN RÁPIDA -->
        <Border Grid.Row="2" Background="#151C21" CornerRadius="10" BorderBrush="#1E2830" BorderThickness="1" Padding="10" Margin="0,0,0,14">
            <WrapPanel HorizontalAlignment="Center">
                <Button Content="Re-enlazar USB (ADB Reverse)" Click="BtnReverseUsb_Click" Style="{StaticResource PrimaryButton}" Margin="5,3"/>
                <Button x:Name="BtnInstallApk" Content="Instalar APK en Celular" Click="BtnInstallApk_Click" Style="{StaticResource SuccessButton}" Margin="5,3"/>
                <Button Content="Reiniciar Servidor" Click="BtnRestartServer_Click" Style="{StaticResource ActionButton}" Margin="5,3"/>
                <Button Content="Abrir Carpeta APKs" Click="BtnOpenApksFolder_Click" Style="{StaticResource ActionButton}" Margin="5,3"/>
                <Button Content="Limpiar Logs" Click="BtnClearLogs_Click" Style="{StaticResource ActionButton}" Margin="5,3"/>
            </WrapPanel>
        </Border>

        <!-- 4. CONSOLA DE LOGS EN VIVO -->
        <Border Grid.Row="3" Background="#070A0D" CornerRadius="10" BorderBrush="#1E2830" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="REGISTRO DE ACTIVIDAD DEL SERVIDOR (LOGS)" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text=" • UTF-8 TIEMPO REAL" FontSize="10" Foreground="#38BDF8" Opacity="0.8"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtConsoleLog"
                             Background="Transparent"
                             Foreground="#7DD3FC"
                             FontFamily="Consolas, Cascadia Code, Courier New"
                             FontSize="11.5"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 5. BARRA DE PIE DE PÁGINA -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="SGNIA Interactive • ATS Telemetry &amp; GPS System" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtFooterStatus" Text="Listo para jugar. Conecta el teléfono por USB o Wi-Fi y abre la app." FontSize="10.5" Foreground="#38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>